# ── 模型配置 ──────────────────────────────────────────
# Main model selector: "deepseek" or "qwen"
MAIN_MODEL=deepseek

# LLM 运行模式: "live"(真实API) / "mock"(零token本地模拟) / "proxy"(转发到model_server)
LLM_MODE=live

# proxy 模式目标地址（配合 model_server 使用）
LLM_PROXY_URL=http://127.0.0.1:8000/v1

# DeepSeek API Configuration
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen / DashScope API Configuration
DASHSCOPE_API_KEY=sk-
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── 记忆系统配置 ──────────────────────────────────────
# 是否启用 LLM 记忆提取（从对话中自动提取偏好/决策写入 MEMORY.md）
# 启用后每次提取会消耗 LLM API 调用，默认关闭
MEMORY_EXTRACTION=false

# 是否将长期记忆（MEMORY.md）注入 system prompt
# 需要先启用 MEMORY_EXTRACTION 才有数据可注入，默认关闭
MEMORY_INJECT_LONG_TERM=false

# 记忆提取最小间隔（秒），防止频繁调用 LLM
MEMORY_LLM_COOLDOWN=30

# ── Agent 配置 ────────────────────────────────────────
# LLM 温度（0.0 确定性 ~ 1.0 创造性）
AGENT_TEMPERATURE=0.2

# ── TUI 配置 ──────────────────────────────────────────
# 日志面板自动隐藏的终端最小宽度（列数），低于此值时自动隐藏
TUI_LOG_MIN_WIDTH=80